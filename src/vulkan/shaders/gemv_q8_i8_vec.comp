#version 460
#include "common.glsl"
#include "int8.glsl"

// Same block accumulation and subgroup reduction as gemv_q8_i8, but read
// each 32-byte weight block as two aligned 16-byte vectors. Q8 cache data
// and rows (cols is a multiple of 32) satisfy Uvec4s' 16-byte alignment.
layout(constant_id = 0) const uint ROWS = 4;
layout(local_size_x = 128, local_size_x_id = 1) in;
layout(push_constant) uniform Params {
  Uvec4s qs;
  Floats scales;
  Uints xq;
  Floats xs;
  Floats y;
  uint rows;
  uint cols;
  uint n;
} p;

void main() {
  const uint row0 = (gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID) * ROWS;
  if (row0 >= p.rows) return;
  const uint rn = min(ROWS, p.rows - row0);
  const uint blocks = p.cols / 32;
  precise float acc[ROWS];
  for (uint r = 0; r < ROWS; r++) acc[r] = 0.0;
  for (uint b = gl_SubgroupInvocationID; b < blocks; b += gl_SubgroupSize) {
    uint x[8];
    for (uint k = 0; k < 8; k++) x[k] = p.xq.v[b * 8 + k];
    const float xscale = p.xs.v[b];
    for (uint r = 0; r < rn; r++) {
      const uint at = (row0 + r) * (p.cols / 16) + b * 2;
      const uvec4 lo = p.qs.v[at], hi = p.qs.v[at + 1];
      int isum = 0;
      for (uint k = 0; k < 4; k++) isum += sdot(lo[k], x[k]);
      for (uint k = 0; k < 4; k++) isum += sdot(hi[k], x[4 + k]);
      acc[r] += float(isum) * (p.scales.v[(row0 + r) * blocks + b] * xscale);
    }
  }
  for (uint r = 0; r < rn; r++) {
    const float v = subgroupAdd(acc[r]);
    if (subgroupElect()) p.y.v[row0 + r] = v;
  }
}

#version 460
#include "common.glsl"

// g = silu(g) * u.
layout(local_size_x = 256) in;
layout(push_constant) uniform Params {
  Floats g;
  Floats u;
  uint count;
} p;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.count) return;
  const float a = p.g.v[i];
  p.g.v[i] = (a / (1.0 + exp(-a))) * p.u.v[i];
}
